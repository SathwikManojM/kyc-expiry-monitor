# Copy to .env for local environment configuration; never commit real credentials.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=kyc_watch
KYC_SECRET_KEY=replace-with-a-long-random-secret
KYC_SEED_DEMO=true
KYC_EXPIRY_WARNING_DAYS=60
KYC_COOKIE_SECURE=false
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Optional: local-only weak admin bootstrap. Do not enable outside a private demo.
KYC_DEMO_ADMIN=false
# Optional secure admin bootstrap for a new database:
# KYC_ADMIN_USERNAME=compliance-admin
# KYC_ADMIN_PASSWORD=replace-with-a-strong-password
